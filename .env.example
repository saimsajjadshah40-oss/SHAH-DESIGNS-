# ─────────────────────────────────────────────────────────────
# SAIM DESIGNER — environment variables
# Copy this file to `.env.local` for local development and add the
# same variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" (or "publishable") key. Safe for the browser ONLY because
# every table and the storage bucket are protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://saimdesigner.com

# Optional: random string used to salt login rate-limit keys (any long random value).
# Generate one with:  openssl rand -hex 32
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# NOTE: This project intentionally does NOT use the Supabase service-role key.
# All admin actions run as the signed-in admin and are authorised by RLS.
